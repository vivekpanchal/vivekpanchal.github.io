---
---

<button id="theme-toggle" class="theme-toggle" type="button">
  <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
  </svg>
  <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
  <!-- Both labels in markup; the inactive one is display:none so the control stays correct without JS. -->
  <span class="sr-only icon-sun">Switch to dark theme</span>
  <span class="sr-only icon-moon">Switch to light theme</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    color: var(--fg-2);
    transition: color var(--transition), background-color var(--transition);
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    color: var(--fg);
    background: var(--bg-subtle);
  }

  .theme-toggle svg {
    width: 18px;
    height: 18px;
  }

  /* --icon-sun / --icon-moon flip with the palette in global.css */
  .icon-sun  { display: var(--icon-sun); }
  .icon-moon { display: var(--icon-moon); }
</style>

<script>
  // Two-state toggle: "system" (no stored value) and "the opposite of system" (stored literally).
  const KEY = 'theme';
  const systemDark = matchMedia('(prefers-color-scheme: dark)');
  const meta = () => document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]');

  function rendered(): 'light' | 'dark' {
    const c = meta()?.content;
    if (c === 'light' || c === 'dark') return c;
    return systemDark.matches ? 'dark' : 'light';
  }

  function set(target: 'light' | 'dark') {
    const system = systemDark.matches ? 'dark' : 'light';
    const m = meta();
    if (m) m.content = target === system ? 'light dark' : target;
    try {
      if (target === system) localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, target);
    } catch {}
  }

  // Delegated so it survives client-side navigation re-rendering the header.
  document.addEventListener('click', (e) => {
    if ((e.target as Element).closest?.('#theme-toggle')) set(rendered() === 'dark' ? 'light' : 'dark');
  });

  // Keep tabs in sync.
  window.addEventListener('storage', (e) => {
    if (e.key !== KEY) return;
    const m = meta();
    if (m) m.content = e.newValue === 'light' || e.newValue === 'dark' ? e.newValue : 'light dark';
  });
</script>
