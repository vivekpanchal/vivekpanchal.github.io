---
import { Image } from 'astro:assets';

const metrics = [
  { value: '8+',   label: 'Years shipping Android' },
  { value: '2M+',  label: 'Users reached' },
  { value: '−75%', label: 'App crashes at Trustt' },
  { value: '5',    label: 'Industries' },
];

const stack = ['Kotlin', 'Jetpack Compose', 'Coroutines & Flow', 'Hilt', 'Clean Architecture', 'MVI'];
---

<section class="hero" id="home" aria-labelledby="hero-title">
  <div class="hero-grid-bg" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="hero-status" style="--i:1">
        <span class="status-dot" aria-hidden="true"></span>
        SDE-2 at <strong>DarioHealth</strong>
        <span class="sep" aria-hidden="true">/</span>
        Delhi, India
      </p>

      <h1 class="hero-title" id="hero-title" style="--i:2">
        <span class="hero-name">Vivek Panchal — Senior Android Engineer</span>
        Building Android apps that scale to <span class="hl">millions of users.</span>
      </h1>

      <p class="hero-lead" style="--i:3">
        Google Certified Android Developer with 8+ years architecting production Kotlin apps —
        healthcare at <strong>DarioHealth</strong>, fintech at <strong>Trustt</strong>, ed-tech at <strong>StudyIQ</strong>, plus agri-tech and on-device ML.
      </p>

      <div class="hero-actions" style="--i:4">
        <a href="#experience" class="btn btn-primary">
          Explore my work
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="#contact" class="btn btn-secondary">Get in touch</a>
        <span class="hero-divider" aria-hidden="true"></span>
        <a href="https://github.com/vivekpanchal" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="GitHub (opens in new tab)">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.2-3.1-.1-.4-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.7 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.1 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z"/></svg>
        </a>
        <a href="https://www.linkedin.com/in/vivekpanchal-developer/" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in new tab)">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
        </a>
      </div>
    </div>

    <aside class="hero-card" aria-label="Profile">
      <div class="hero-card-top">
        <Image
          src="https://avatars.githubusercontent.com/u/22134822?v=4"
          alt="Portrait of Vivek Panchal"
          width={128}
          height={128}
          loading="eager"
          class="hero-avatar"
        />
        <div>
          <p class="hero-card-name">Vivek Panchal</p>
          <p class="hero-card-role">Senior Android Engineer</p>
          <p class="hero-card-cert">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15a6 6 0 1 0 0-12 6 6 0 0 0 0 12Z"/><path d="m8.2 13.9-1.2 7.1 5-3 5 3-1.2-7.1"/></svg>
            Google Certified Android Developer
          </p>
        </div>
      </div>
      <p class="hero-card-label mono">Core stack</p>
      <ul class="hero-stack">
        {stack.map((s) => <li class="tag">{s}</li>)}
      </ul>
    </aside>

    <dl class="hero-metrics">
      {metrics.map((m, i) => (
        <div class="metric" style={`--i:${i + 1}`}>
          <dt>{m.label}</dt>
          <dd>{m.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: var(--space-9) 0 var(--space-8);
    overflow: clip;
    isolation: isolate;
  }

  /* Faint engineering grid, faded out toward the edges */
  .hero-grid-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 40%, transparent 100%);
  }

  /* ---------- Entrance: one-time stagger on load ----------
     sibling-index() drives the delay; the static --i (set in markup) is the fallback
     for browsers without it, so no JS is needed. The h1 is the LCP element, so it
     only rises — fading it from opacity 0 would delay LCP. */
  @keyframes hero-fade-up {
    from { opacity: 0; translate: 0 14px; }
  }

  @keyframes hero-rise {
    from { translate: 0 10px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > *,
    .hero-card,
    .metric {
      --stagger: 80ms;
      animation: hero-fade-up 700ms var(--ease-out) backwards;
      animation-delay: calc(var(--i, 0) * var(--stagger));
      animation-delay: calc(sibling-index() * var(--stagger));
    }

    .hero-copy > .hero-title { animation-name: hero-rise; }

    /* Card and metrics follow the copy */
    .hero-card { animation-delay: 360ms; }
    .metric {
      animation-delay: calc(420ms + var(--i, 0) * 60ms);
      animation-delay: calc(420ms + sibling-index() * 60ms);
    }

    .status-dot::after { animation: status-pulse 2.4s var(--ease-out) infinite; }
  }

  /* Compositor-only ripple (transform + opacity) */
  @keyframes status-pulse {
    0%   { scale: 1; opacity: 0.6; }
    70%, 100% { scale: 2.6; opacity: 0; }
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
  }

  @media (min-width: 960px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr) 320px;
      column-gap: var(--space-8);
      align-items: center;
    }
    .hero-metrics { grid-column: 1 / -1; }
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    margin-bottom: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--bg-elevated);
    font-size: var(--text-sm);
    color: var(--fg-2);
  }

  .hero-status strong { color: var(--fg); font-weight: 600; }
  .sep { color: var(--border-strong); }

  .status-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .status-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--accent);
    opacity: 0;
  }

  .hero-title {
    font-size: var(--text-hero);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    line-height: 1.04;
    margin-bottom: var(--space-5);
    max-width: 16ch;
  }

  .hero-name {
    display: block;
    margin-bottom: var(--space-4);
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.4;
    color: var(--fg-2);
  }

  .hl { color: var(--fg-muted); }

  .hero-lead {
    font-size: var(--text-lg);
    color: var(--fg-2);
    max-width: 58ch;
    margin-bottom: var(--space-6);
  }

  .hero-lead strong { color: var(--fg); font-weight: 600; }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .hero-divider {
    width: 1px;
    height: 24px;
    margin-inline: var(--space-1);
    background: var(--border);
  }

  @media (max-width: 480px) {
    .hero-actions .btn { flex: 1 1 100%; }
    .hero-divider { display: none; }
  }

  /* Profile card */
  .hero-card {
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    box-shadow: var(--shadow-lg);
  }

  .hero-card-top {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-bottom: var(--space-5);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .hero-avatar {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--bg-subtle);
  }

  .hero-card-name { font-weight: 600; }
  .hero-card-role { font-size: var(--text-sm); color: var(--fg-2); }

  .hero-card-cert {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    color: var(--accent);
  }

  .hero-card-cert svg { width: 14px; height: 14px; }

  .hero-card-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-muted);
    margin-bottom: var(--space-3);
  }

  .hero-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Metrics strip — hairline-divided cells */
  .hero-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--border);
    overflow: hidden;
  }

  @media (min-width: 720px) {
    .hero-metrics { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .metric {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-1);
    padding: var(--space-5);
    background: var(--bg);
  }

  .metric dd {
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .metric dt {
    font-size: var(--text-sm);
    color: var(--fg-2);
  }
</style>
