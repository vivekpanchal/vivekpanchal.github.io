---
const GITHUB_USER = 'vivekpanchal';

const filters = [
  { id: 'all',     label: 'All' },
  { id: 'android', label: 'Android' },
  { id: 'kotlin',  label: 'Kotlin' },
  { id: 'ai',      label: 'AI / Cloud' },
  { id: 'dsa',     label: 'Algorithms' },
];

// stars/forks are fallbacks; live counts are fetched at build time below.
const projects = [
  {
    name: 'MovieMania',
    description: 'Movie discovery app on TheMovieDB API — trending titles, ratings and cast in a clean Material UI.',
    language: 'Kotlin', langColor: '#A97BFF',
    stars: 3, forks: 2,
    cats: ['android', 'kotlin'],
    tags: ['MVVM', 'Retrofit', 'Material'],
  },
  {
    name: 'GithubTrending',
    description: 'Trending GitHub repositories, built on MVVM with Dagger2 DI and RxJava reactive streams.',
    language: 'Java', langColor: '#b07219',
    stars: 2, forks: 1,
    cats: ['android'],
    tags: ['MVVM', 'Dagger2', 'RxJava'],
  },
  {
    name: 'watbot',
    description: 'Voice-enabled chatbot on IBM Watson Conversation, Speech-to-Text and Text-to-Speech (IBM Cloud).',
    language: 'Java', langColor: '#b07219',
    stars: 2, forks: 0,
    cats: ['android', 'ai'],
    tags: ['IBM Watson', 'Voice AI', 'Cloud'],
  },
  {
    name: 'NewsHUB',
    description: 'Multi-source news aggregator with offline reading and a distraction-free browsing experience.',
    language: 'Java', langColor: '#b07219',
    stars: 2, forks: 0,
    cats: ['android'],
    tags: ['Retrofit', 'Room', 'Offline-first'],
  },
  {
    name: 'HackerRankSolutions',
    description: 'Interview Preparation Kit solutions in clean, commented Java across algorithms and data structures.',
    language: 'Java', langColor: '#b07219',
    stars: 5, forks: 7,
    cats: ['dsa'],
    tags: ['Algorithms', 'Data Structures'],
  },
  {
    name: 'NewsReaderApp',
    description: 'Minimal tech-news reader powered by the HackerNews API.',
    language: 'Java', langColor: '#b07219',
    stars: 1, forks: 0,
    cats: ['android'],
    tags: ['HackerNews API', 'RecyclerView'],
  },
];

// Build-time enrichment: one unauthenticated request; falls back to the static numbers on any failure.
try {
  const res = await fetch(`https://api.github.com/users/${GITHUB_USER}/repos?per_page=100`, {
    headers: { Accept: 'application/vnd.github+json' },
    signal: AbortSignal.timeout(5000),
  });
  if (res.ok) {
    const repos: { name: string; stargazers_count: number; forks_count: number }[] = await res.json();
    const byName = new Map(repos.map((r) => [r.name, r]));
    for (const p of projects) {
      const live = byName.get(p.name);
      if (live) { p.stars = live.stargazers_count; p.forks = live.forks_count; }
    }
  }
} catch {}

const countFor = (id: string) => (id === 'all' ? projects.length : projects.filter((p) => p.cats.includes(id)).length);

// Zero-JS filtering: the checked radio hides non-matching cards via :has().
const filterCss = filters
  .filter((f) => f.id !== 'all')
  .map((f) => `#projects:has(input[value="${f.id}"]:checked) .project-card:not([data-cats~="${f.id}"]){display:none}`)
  .join('');
---

<section class="projects section" id="projects" aria-labelledby="projects-title">
  <style is:inline set:html={filterCss}></style>
  <div class="container">
    <header class="section-header reveal">
      <p class="section-num">02 / Open source</p>
      <h2 class="section-title" id="projects-title">Things I've built in the open.</h2>
      <p class="section-subtitle">Side projects where I try out architectures, libraries and APIs before they reach production.</p>
    </header>

    <fieldset class="filters">
      <legend class="sr-only">Filter projects by category</legend>
      {filters.map((f) => (
        <label class="chip">
          <input type="radio" name="project-filter" value={f.id} checked={f.id === 'all'} />
          {f.label}
          <span class="chip-count" aria-label={`${countFor(f.id)} projects`}>{countFor(f.id)}</span>
        </label>
      ))}
    </fieldset>

    <ul class="projects-grid">
      {projects.map((p) => {
        const url = `https://github.com/${GITHUB_USER}/${p.name}`;
        return (
          <li class="project-card" data-cats={p.cats.join(' ')}>
            <div class="pc-top">
              <span class="pc-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4z"/><path d="M17 14v6M14 17h6"/></svg>
              </span>
              <svg class="pc-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
            </div>

            <h3 class="pc-name">
              <a href={url} target="_blank" rel="noopener noreferrer">
                {p.name}<span class="sr-only"> (GitHub, opens in new tab)</span>
              </a>
            </h3>
            <p class="pc-desc">{p.description}</p>

            <ul class="pc-tags" aria-label="Tech stack">
              {p.tags.map((t) => <li class="tag">{t}</li>)}
            </ul>

            <div class="pc-meta">
              <span class="pc-lang">
                <span class="lang-dot" style={`background:${p.langColor}`} aria-hidden="true"></span>
                {p.language}
              </span>
              <span class="pc-stat">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z"/></svg>
                {p.stars}<span class="sr-only"> stars</span>
              </span>
              <span class="pc-stat">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="6" cy="5" r="2"/><circle cx="18" cy="5" r="2"/><circle cx="12" cy="19" r="2"/><path d="M6 7v2a3 3 0 0 0 3 3h6a3 3 0 0 0 3-3V7M12 12v5"/></svg>
                {p.forks}<span class="sr-only"> forks</span>
              </span>
            </div>
          </li>
        );
      })}
    </ul>

    <div class="projects-cta">
      <a href={`https://github.com/${GITHUB_USER}`} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
        View all repositories on GitHub
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* Filter chips: native radios — arrow keys move between them, no JS. */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    border: 0;
  }

  .chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 40px;
    padding: 0 var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--bg);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--fg-2);
    cursor: pointer;
    transition: color var(--transition), background-color var(--transition), border-color var(--transition);
  }

  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .chip:hover { color: var(--fg); border-color: var(--border-strong); }

  .chip:has(input:checked) {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }

  .chip:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .chip-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    opacity: 0.7;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: var(--space-4);
  }

  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    transition: border-color var(--transition), box-shadow var(--transition), translate var(--transition);
  }

  .project-card:hover,
  .project-card:focus-within {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-lg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .project-card:hover { translate: 0 -3px; }
  }

  .pc-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-1);
  }

  .pc-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--accent);
  }

  .pc-icon svg { width: 20px; height: 20px; }

  .pc-arrow {
    width: 18px;
    height: 18px;
    color: var(--fg-muted);
    transition: color var(--transition), translate var(--transition);
  }

  .project-card:hover .pc-arrow {
    color: var(--fg);
    translate: 2px -2px;
  }

  .pc-name {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .pc-name a { color: var(--fg); }

  /* Stretched link: the whole card is the click target, one tab stop per card */
  .pc-name a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .pc-name a:focus-visible { outline: none; }
  .project-card:has(.pc-name a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .pc-desc {
    flex: 1;
    font-size: var(--text-sm);
    color: var(--fg-2);
  }

  .pc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .pc-meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-3);
    margin-top: var(--space-1);
    border-top: 1px solid var(--border);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .pc-lang,
  .pc-stat {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-variant-numeric: tabular-nums;
  }

  .pc-lang { margin-right: auto; }

  .pc-stat svg { width: 14px; height: 14px; }

  .lang-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .projects-cta {
    margin-top: var(--space-6);
  }
</style>
