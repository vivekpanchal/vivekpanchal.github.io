---
// Grouped by company so promotions read as growth, not job-hopping.
// Impact bullets restate existing claims — swap in hard numbers (crash-free %, ANR, cold start, MAU) when you have them.
const experiences = [
  {
    company: 'Dario',
    domain: 'Digital health',
    location: 'New Delhi, India',
    current: true,
    roles: [{ title: 'SDE-2 — Android', period: 'Nov 2024 – Present' }],
    summary: 'Leading Android development for a digital health platform.',
    impact: [
      'Architect scalable features on MVVM + Clean Architecture with Hilt for DI.',
      'Drive app-wide performance improvements.',
      'Partner cross-functionally with product and design on delivery.',
    ],
    stack: ['Kotlin', 'MVVM', 'Clean Architecture', 'Hilt', 'Jetpack'],
  },
  {
    company: 'Trustt',
    domain: 'Fintech',
    location: 'Bangalore, India',
    roles: [
      { title: 'SDE-2 — Android', period: 'Jun 2023 – Nov 2024' },
      { title: 'SDE — Android', period: 'Jun 2022 – May 2023' },
    ],
    summary: 'Promoted from SDE to SDE-2 within a year; owned core Android product features.',
    impact: [
      'Led key feature development and improved the app architecture.',
      'Drove adoption of Kotlin Coroutines and modern Jetpack components.',
      'Mentored junior engineers.',
      'Implemented complex UI flows, API integrations and performance optimisations.',
    ],
    stack: ['Kotlin', 'Coroutines', 'Jetpack', 'MVVM', 'REST APIs'],
  },
  {
    company: 'StudyIQ Education',
    domain: 'Ed-tech · millions of students',
    location: 'Delhi, India',
    roles: [{ title: 'Senior Android Developer', period: 'Jul 2020 – Feb 2022' }],
    summary: 'Built and maintained the StudyIQ app used by millions of students across India.',
    impact: [
      'Built live video streaming on ExoPlayer.',
      'Shipped offline content downloads backed by Room.',
      'Owned performance-critical features at scale.',
    ],
    stack: ['ExoPlayer', 'Live Streaming', 'Room', 'Android SDK'],
  },
  {
    company: 'Broad Strokes Ventures',
    domain: 'Product studio',
    location: 'Delhi, India',
    roles: [{ title: 'Senior Android Developer', period: 'Aug 2019 – Apr 2020' }],
    summary: 'Built Android applications end-to-end.',
    impact: [
      'Owned architecture decisions and SDK integrations.',
      'Delivered production-ready mobile features.',
    ],
    stack: ['Java', 'Android SDK'],
  },
  {
    company: 'Stackfusion',
    domain: 'Software services',
    location: 'Gurugram, India',
    roles: [{ title: 'Android Developer', period: 'Jul 2018 – Aug 2019' }],
    summary: 'Started my career building and shipping Android apps across the full mobile lifecycle.',
    impact: [],
    stack: ['Java', 'REST APIs'],
  },
];
---

<section class="experience section section-alt" id="experience" aria-labelledby="experience-title">
  <div class="container">
    <header class="section-header reveal">
      <p class="section-num">01 / Experience</p>
      <h2 class="section-title" id="experience-title">7+ years, five companies, one craft.</h2>
      <p class="section-subtitle">From first app to leading Android architecture — digital health, fintech and ed-tech at scale.</p>
    </header>

    <ol class="timeline">
      {experiences.map((exp, i) => (
        <li class="tl-item reveal" data-current={exp.current ? '' : undefined}>
          <span class="tl-dot" aria-hidden="true"></span>

          <article class="tl-card">
            <header class="tl-head">
              <div>
                <h3 class="tl-company">
                  {exp.company}
                  {exp.current && <span class="tl-badge">Current</span>}
                </h3>
                <p class="tl-domain">{exp.domain} · {exp.location}</p>
              </div>
            </header>

            <ul class="tl-roles">
              {exp.roles.map((r) => (
                <li>
                  <span class="tl-role">{r.title}</span>
                  <span class="tl-period mono">{r.period}</span>
                </li>
              ))}
            </ul>

            <p class="tl-summary">{exp.summary}</p>

            {exp.impact.length > 0 && (
              <details class="tl-details" open={i < 2}>
                <summary>
                  Impact &amp; architecture
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <ul class="tl-impact">
                  {exp.impact.map((item) => <li>{item}</li>)}
                </ul>
              </details>
            )}

            <ul class="tl-stack" aria-label="Tech stack">
              {exp.stack.map((s) => <li class="tag">{s}</li>)}
            </ul>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline {
    --rail-x: 7px;
    position: relative;
    display: grid;
    gap: var(--space-5);
    padding-left: var(--space-6);
    view-timeline: --timeline;
  }

  /* Static rail */
  .timeline::before,
  .timeline::after {
    content: '';
    position: absolute;
    left: var(--rail-x);
    top: var(--space-5);
    bottom: var(--space-5);
    width: 1px;
    background: var(--border-strong);
  }

  /* Progress rail: fills as the timeline scrolls through (decorative, enhancement only) */
  .timeline::after {
    background: var(--accent);
    transform-origin: 50% 0;
    scale: 1 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports ((animation-timeline: view()) and (animation-range: entry)) {
      @keyframes rail-fill {
        to { scale: 1 1; }
      }
      .timeline::after {
        animation: rail-fill linear both;
        animation-timeline: --timeline;
        animation-range: cover 15% cover 75%;
      }
    }
  }

  .tl-item { position: relative; }

  .tl-dot {
    position: absolute;
    left: calc(-1 * var(--space-6) + var(--rail-x) - 5px);
    top: calc(var(--space-5) + 4px);
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg-elevated);
    border: 2px solid var(--border-strong);
    z-index: 1;
  }

  .tl-item[data-current] .tl-dot {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .tl-card {
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .tl-card:hover,
  .tl-card:focus-within {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  .tl-company {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-xl);
  }

  .tl-badge {
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tl-domain {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  /* Multiple roles at one company render as a promotion ladder */
  .tl-roles {
    display: grid;
    gap: var(--space-2);
    margin-block: var(--space-4);
  }

  .tl-roles li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
  }

  .tl-roles li + li {
    padding-top: var(--space-2);
    border-top: 1px dashed var(--border);
  }

  .tl-roles li + li .tl-role { color: var(--fg-2); font-weight: 500; }

  .tl-role { font-weight: 600; }

  .tl-period {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    white-space: nowrap;
  }

  .tl-summary {
    color: var(--fg-2);
    margin-bottom: var(--space-4);
  }

  .tl-details {
    margin-bottom: var(--space-4);
    border-top: 1px solid var(--border);
  }

  .tl-details summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .tl-details summary::-webkit-details-marker { display: none; }

  .tl-details summary svg {
    width: 18px;
    height: 18px;
    color: var(--fg-muted);
    transition: rotate var(--transition);
  }

  .tl-details[open] summary svg { rotate: 180deg; }

  .tl-impact {
    display: grid;
    gap: var(--space-2);
    padding-bottom: var(--space-2);
  }

  .tl-impact li {
    position: relative;
    padding-left: var(--space-5);
    color: var(--fg-2);
    font-size: var(--text-sm);
  }

  .tl-impact li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 1px;
    background: var(--accent);
  }

  .tl-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
