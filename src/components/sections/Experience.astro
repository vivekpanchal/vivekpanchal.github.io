---
// Source: resume (2026) + Cypress letter of experience. `stats` render as headline impact chips.
const experiences = [
  {
    company: 'DarioHealth',
    domain: 'Healthcare / Wellness',
    location: 'Bangalore, India',
    current: true,
    roles: [{ title: 'SDE-2 — Android', period: 'Nov 2024 – Present' }],
    summary: 'Android engineer on a digital health platform serving the US market.',
    stats: [],
    impact: [
      'Led the app-wide rebrand from Twill to Dario Mind — UI, branding assets and user flows aligned to the new design system.',
      'Delivered performance enhancements and full WCAG accessibility compliance for the US market.',
    ],
    stack: ['Kotlin', 'Android SDK', 'MVVM', 'WCAG'],
  },
  {
    company: 'Trustt',
    note: 'formerly Novopay',
    domain: 'Fintech / Banking',
    location: 'Bangalore, India',
    roles: [{ title: 'SDE-2 — Android', period: 'Jun 2022 – Oct 2024' }],
    summary: 'Owned stability, architecture and delivery for a banking app.',
    stats: [
      { value: '−75%', label: 'app crashes' },
      { value: '−70%', label: 'bugs' },
      { value: '−80%', label: 'network latency' },
    ],
    impact: [
      'Optimised the crash-reporting system and data management, cutting app crashes by 75%.',
      'Led a complete MVC → MVVM migration, reducing bugs by 70% and improving maintainability.',
      'Introduced API call optimisations and caching, reducing network latency by 80%.',
      'Established CI/CD pipelines, increasing deployment frequency and automating test workflows.',
    ],
    stack: ['Kotlin', 'MVVM', 'Coroutines & Flow', 'Caching', 'CI/CD'],
  },
  {
    company: 'Cypress',
    note: 'Mobsquad',
    freelance: true,
    domain: 'Contract · multiple client projects',
    location: 'Remote · Yerevan, Armenia',
    roles: [{ title: 'Sr. Android Developer', period: 'Jan 2022 – May 2022' }],
    summary: 'Contract Android engineering for international clients.',
    stats: [],
    impact: [
      'Built and deployed mobile apps end to end across multiple client projects.',
      'Applied MVVM, Dagger Hilt and Room with advanced threading and app-performance optimisation.',
      'Built advanced UI following Material Design guidelines.',
    ],
    stack: ['Kotlin', 'MVVM', 'Hilt', 'Room', 'Material Design'],
  },
  {
    company: 'StudyIQ',
    domain: 'EdTech · millions of students',
    location: 'Delhi, India',
    roles: [{ title: 'Senior Android Developer', period: 'Jul 2020 – Feb 2022' }],
    summary: 'Re-architected the StudyIQ app used by millions of students.',
    stats: [{ value: '−30%', label: 'development time' }],
    impact: [
      'Revamped the StudyIQ app architecture with Kotlin, MVVM and Jetpack, reducing development time by 30%.',
      'Led the PocketNews migration from MVC to MVVM with Dagger Hilt for better performance and maintainability.',
      'Implemented secure data-management protocols to protect user data.',
      'Owned unit and UI testing for release quality.',
    ],
    stack: ['Kotlin', 'MVVM', 'Jetpack', 'Hilt', 'ExoPlayer'],
  },
  {
    company: 'Broad Stroke Group',
    domain: 'Agri-Tech',
    location: 'New Delhi, India',
    roles: [{ title: 'Android Developer', period: 'Aug 2019 – Apr 2020' }],
    summary: 'Turned an agri-tech app around on retention and data visualisation.',
    stats: [{ value: '+80%', label: 'user retention' }],
    impact: [
      'Improved user retention by 80% through targeted bug fixes, UI/UX improvements and security hardening.',
      'Built advanced graph and map features for data visualisation.',
      'Partnered with product managers on estimation and delivery timelines.',
    ],
    stack: ['Java', 'Maps', 'Data visualisation'],
  },
  {
    company: 'Stackfusion',
    note: 'Parkzap Labs',
    domain: 'AI/ML · IoT',
    location: 'Gurugram, India',
    roles: [{ title: 'Android Developer', period: 'Jul 2018 – Aug 2019' }],
    summary: 'On-device computer vision and IoT products.',
    stats: [{ value: '+95%', label: 'OCR accuracy' }],
    impact: [
      'Integrated TensorFlow Lite and OpenCV for licence-plate detection, increasing OCR accuracy by 95%.',
      'Contributed to IoT products including RFID sensors and automated printers.',
      'Mentored junior developers and drove cross-functional work on Android networking.',
    ],
    stack: ['TensorFlow Lite', 'OpenCV', 'IoT', 'Java'],
  },
];
---

<section class="experience section section-alt" id="experience" aria-labelledby="experience-title">
  <div class="container">
    <header class="section-header reveal">
      <p class="section-num">01 / Experience</p>
      <h2 class="section-title" id="experience-title">8+ years, six teams, five industries.</h2>
      <p class="section-subtitle">From on-device ML to banking-grade stability — healthcare, fintech, ed-tech, agri-tech and AI/ML.</p>
    </header>

    <ol class="timeline">
      {experiences.map((exp, i) => (
        <li class="tl-item reveal" data-current={exp.current ? '' : undefined}>
          <span class="tl-dot" aria-hidden="true"></span>

          <article class="tl-card">
            <header class="tl-head">
              <div>
                <h3 class="tl-company">
                  {exp.company}
                  {exp.note && <span class="tl-note">({exp.note})</span>}
                  {exp.current && <span class="tl-badge">Current</span>}
                  {exp.freelance && <span class="tl-badge tl-badge-muted">Freelance</span>}
                </h3>
                <p class="tl-domain">{exp.domain} · {exp.location}</p>
              </div>
            </header>

            <ul class="tl-roles">
              {exp.roles.map((r) => (
                <li>
                  <span class="tl-role">{r.title}</span>
                  <span class="tl-period mono">{r.period}</span>
                </li>
              ))}
            </ul>

            <p class="tl-summary">{exp.summary}</p>

            {exp.stats.length > 0 && (
              <ul class="tl-stats" aria-label="Key results">
                {exp.stats.map((st) => (
                  <li><strong>{st.value}</strong> {st.label}</li>
                ))}
              </ul>
            )}

            {exp.impact.length > 0 && (
              <details class="tl-details" open={i < 2}>
                <summary>
                  Impact &amp; architecture
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <ul class="tl-impact">
                  {exp.impact.map((item) => <li>{item}</li>)}
                </ul>
              </details>
            )}

            <ul class="tl-stack" aria-label="Tech stack">
              {exp.stack.map((s) => <li class="tag">{s}</li>)}
            </ul>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline {
    --rail-x: 7px;
    position: relative;
    display: grid;
    gap: var(--space-5);
    padding-left: var(--space-6);
    view-timeline: --timeline;
  }

  /* Static rail */
  .timeline::before,
  .timeline::after {
    content: '';
    position: absolute;
    left: var(--rail-x);
    top: var(--space-5);
    bottom: var(--space-5);
    width: 1px;
    background: var(--border-strong);
  }

  /* Progress rail: fills as the timeline scrolls through (decorative, enhancement only) */
  .timeline::after {
    background: var(--accent);
    transform-origin: 50% 0;
    scale: 1 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports ((animation-timeline: view()) and (animation-range: entry)) {
      @keyframes rail-fill {
        to { scale: 1 1; }
      }
      .timeline::after {
        animation: rail-fill linear both;
        animation-timeline: --timeline;
        animation-range: cover 15% cover 75%;
      }
    }
  }

  .tl-item { position: relative; }

  .tl-dot {
    position: absolute;
    left: calc(-1 * var(--space-6) + var(--rail-x) - 5px);
    top: calc(var(--space-5) + 4px);
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg-elevated);
    border: 2px solid var(--border-strong);
    z-index: 1;
  }

  .tl-item[data-current] .tl-dot {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .tl-card {
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .tl-card:hover,
  .tl-card:focus-within {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  .tl-company {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-xl);
  }

  .tl-badge {
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tl-note {
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--fg-muted);
  }

  .tl-badge-muted {
    background: var(--bg-subtle);
    color: var(--fg-2);
  }

  .tl-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .tl-stats li {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    font-size: var(--text-sm);
    color: var(--fg-2);
  }

  .tl-stats strong {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .tl-domain {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  /* Multiple roles at one company render as a promotion ladder */
  .tl-roles {
    display: grid;
    gap: var(--space-2);
    margin-block: var(--space-4);
  }

  .tl-roles li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
  }

  .tl-roles li + li {
    padding-top: var(--space-2);
    border-top: 1px dashed var(--border);
  }

  .tl-roles li + li .tl-role { color: var(--fg-2); font-weight: 500; }

  .tl-role { font-weight: 600; }

  .tl-period {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    white-space: nowrap;
  }

  .tl-summary {
    color: var(--fg-2);
    margin-bottom: var(--space-4);
  }

  .tl-details {
    margin-bottom: var(--space-4);
    border-top: 1px solid var(--border);
  }

  .tl-details summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .tl-details summary::-webkit-details-marker { display: none; }

  .tl-details summary svg {
    width: 18px;
    height: 18px;
    color: var(--fg-muted);
    transition: rotate var(--transition);
  }

  .tl-details[open] summary svg { rotate: 180deg; }

  .tl-impact {
    display: grid;
    gap: var(--space-2);
    padding-bottom: var(--space-2);
  }

  .tl-impact li {
    position: relative;
    padding-left: var(--space-5);
    color: var(--fg-2);
    font-size: var(--text-sm);
  }

  .tl-impact li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 1px;
    background: var(--accent);
  }

  .tl-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
